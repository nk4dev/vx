{
  "name": "vx3",
  "version": "0.1.3",
  "description": "A CLI tool for vx3 smart contracts platform",
  "main": "dist/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "import": "./dist/esm/index.browser.mjs",
        "default": "./dist/esm/index.browser.mjs"
      },
      "import": "./dist/esm/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/front_api/react.d.ts",
      "import": "./dist/esm/front_api/react.mjs",
      "require": "./dist/front_api/react.js",
      "default": "./dist/front_api/react.js"
    },
    "./core/config": {
      "types": "./dist/core/config.d.ts",
      "import": "./dist/esm/core/config.mjs",
      "require": "./dist/core/config.js",
      "default": "./dist/core/config.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "author": "Nknight AMAMIYA@nk4dev <nknighta@varius.technology>",
  "files": [
    "dist",
    "packages/template",
    "packages/hardhat",
    "packages/react-template",
    "packages/vue-template"
  ],
  "homepage": "https://vx.nknighta.me",
  "license": "MIT",
  "keywords": [
    "web3",
    "vx3",
    "cli",
    "smart-contracts"
  ],
  "bin": {
    "vx3": "dist/cli.js"
  },
  "scripts": {
    "build:esm": "bun scripts/build-esm.mjs",
    "build:nft-artifact": "node scripts/build-nft-artifact.cjs",
    "build": "rimraf dist && tsc && bun run build:esm",
    "prepare": "bun run build",
    "clean": "rimraf dist",
    "dev": "node dist/cli.js",
    "start": "bun run build && node dist/cli.js api --debug",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "pretest": "bun run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "hh": "hardhat --config packages/hardhat/hardhat.config.ts",
    "hh:compile": "hardhat --config packages/hardhat/hardhat.config.ts compile",
    "hh:test": "hardhat --config packages/hardhat/hardhat.config.ts test",
    "hh:node": "hardhat --config packages/hardhat/hardhat.config.ts node",
    "hh:deploy": "hardhat --config packages/hardhat/hardhat.config.ts run packages/hardhat/scripts/deploy.ts --network localhost"
  },
  "dependencies": {
    "@vx3/solc-compiler": "github:nk4dev/vx-solc",
    "commander": "^12.1.0",
    "ethers": "^6.15.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "hardhat": "^2.22.0",
    "jest": "^30.0.5",
    "prettier": "^3.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.0.1",
    "solc": "^0.8.30",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
